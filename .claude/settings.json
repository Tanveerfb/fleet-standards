{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|PowerShell",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/standards/scripts/block-shell-writes.mjs\"",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
